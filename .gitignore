# Dependencies
node_modules/
.pnp/
.pnp.js

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects are generated (Continuous Native Generation) — do not commit
android/
ios/

# Build outputs and signing material
*.apk
*.aab
*.ipa
*.keystore
*.jks
!debug.keystore
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md

# Caches
.metro-health-check*
*.tsbuildinfo
.cache/
coverage/

# Environment and secrets (a Spotify client secret must never exist in this repo)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Raw BLE captures and official-app logs stay local unless deliberately exported.
# Curated replay fixtures are committed under src/protocol/**/fixtures/ instead.
captures/
*.btsnoop
*.btsnoop.log
btsnoop_hci.log
*.pcap
*.pcapng
*.bugreport.zip

# Local Claude Code session state
.claude/

# Kokoro model files — ~350MB, downloaded by tools/voice/README, never committed.
tools/voice/models/

# Voice QA loop artifacts — regenerated by export-expectations.mjs / validate_clips.py
tools/analysis/
tools/voice/__pycache__/
tools/audition/__pycache__/

# Punch-avatar master art (35 MB). The shipped frames are generated into
# assets/avatar/punch/ by tools/avatar/make_punch_frames.py.
assets/branding/Punch Step1s/
assets/branding/Punch Step2s/
