{
  "name": "punchlab-puncheokie",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Android-first Expo app reviving FightCamp v1 BLE punch trackers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "prebuild": "expo prebuild --clean",
    "prebuild:no-clean": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "guard:velocity-terminology": "node tools/guards/velocity-terminology.mjs"
  },
  "dependencies": {
    "@sfourdrinier/react-native-ble-plx": "3.9.3",
    "expo": "57.0.15",
    "expo-auth-session": "~57.0.8",
    "expo-build-properties": "~57.0.13",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-native": "5.0.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "~5.9.2"
  }
}
